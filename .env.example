# Скопіюйте у .env: cp .env.example .env
# .env не потрапляє в git. На ВМ — власний .env із сильними паролями.

# --- PostgreSQL (суперкористувач сервера; ролі сервісів створює db-init окремою карткою)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-dev-only-change-me
# Порт на хості (лише 127.0.0.1). Якщо 5432 зайнятий локальним PostgreSQL — змініть, наприклад, на 5433.
PG_PORT=5432

# Ролі бази tenant (створює db-init). Ці ж паролі — у DATABASE_URL і MIGRATION_DATABASE_URL
# у .env репозиторію tenant-service.
TENANT_OWNER_DB_PASSWORD=local-tenant-owner-pass
TENANT_APP_DB_PASSWORD=local-tenant-app-pass
TENANT_RELAY_DB_PASSWORD=local-tenant-relay-pass
TENANT_MAINT_DB_PASSWORD=local-tenant-maint-pass

# --- Kafka
# Порт для сервісів, запущених на хості: localhost:29092. Контейнери ходять на kafka:9092.
KAFKA_EXTERNAL_PORT=29092
# Ідентифікатор кластера KRaft: base64 від 16 байт (UUID), 22 символи. Новий: python3 -c "import uuid,base64;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip(\"=\"))"
# Не змінюйте після першого запуску: Kafka не прочитає свій том (допоможе лише make reset).
KAFKA_CLUSTER_ID=TX4v_oipS5WiDI8HDaVfvw

# --- Шлюз Traefik
# Порт, на якому відкривається система: http://localhost
HTTP_PORT=80

# --- Keycloak
# Публічна адреса системи: потрапляє в токени як iss і в дозволені redirect_uri клієнта web.
# Якщо HTTP_PORT не 80 — додайте порт: http://localhost:8080. На ВМ — https://<домен>.
# Змінили після першого запуску — make kc-reset (realm імпортується лише раз).
LAD_PUBLIC_URL=http://localhost
# Адмін-консоль: http://localhost:8180/idp/admin (лише 127.0.0.1; на ВМ — через SSH-тунель).
KC_ADMIN_PORT=8180
KC_ADMIN_PASSWORD=local-kc-admin-pass
KEYCLOAK_DB_PASSWORD=local-keycloak-db-pass
# Користувачі realm lad (мінімум 10 символів — політика паролів realm).
SYSADMIN_PASSWORD=local-sysadmin-pass
DEMO_SCHEDULER_PASSWORD=local-demo-pass
# school_id демо-закладу: однаковий у Keycloak і в сіді баз даних.
DEMO_SCHOOL_ID=5d0b6a1e-7c3f-4b2a-9e41-0a1d2c3b4e5f
# Секрет клієнта tenant-service (admin API Keycloak). Той самий секрет — у .env tenant-service.
TENANT_CLIENT_SECRET=local-tenant-secret-change-me

# Куди шлюз веде запити. За замовчуванням — сервіси, запущені на хості (npm run dev).
# Порти домовлені для всіх: web 5173, tenant 3001, school 3002, timetable 3003.
# Коли сервіс працює в контейнері compose — вкажіть http://<ім'я-сервісу>:8080.
WEB_UPSTREAM=http://host.docker.internal:5173
KEYCLOAK_UPSTREAM=http://keycloak:8080
TENANT_UPSTREAM=http://host.docker.internal:3001
SCHOOL_UPSTREAM=http://host.docker.internal:3002
TIMETABLE_UPSTREAM=http://host.docker.internal:3003
