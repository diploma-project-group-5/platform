# Скопіюйте у .env: cp .env.example .env
# .env не потрапляє в git. На ВМ — власний .env із сильними паролями.

# --- PostgreSQL (суперкористувач сервера; ролі сервісів створює db-init окремою карткою)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-dev-only-change-me
# Порт на хості (лише 127.0.0.1). Якщо 5432 зайнятий локальним PostgreSQL — змініть, наприклад, на 5433.
PG_PORT=5432

# --- Kafka
# Порт для сервісів, запущених на хості: localhost:29092. Контейнери ходять на kafka:9092.
KAFKA_EXTERNAL_PORT=29092
# Ідентифікатор кластера KRaft: base64 від 16 байт (UUID), 22 символи. Новий: python3 -c "import uuid,base64;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip(\"=\"))"
# Не змінюйте після першого запуску: Kafka не прочитає свій том (допоможе лише make reset).
KAFKA_CLUSTER_ID=TX4v_oipS5WiDI8HDaVfvw

# --- Шлюз Traefik
# Порт, на якому відкривається система: http://localhost
HTTP_PORT=80

# Куди шлюз веде запити. За замовчуванням — сервіси, запущені на хості (npm run dev).
# Порти домовлені для всіх: web 5173, tenant 3001, school 3002, timetable 3003.
# Коли сервіс працює в контейнері compose — вкажіть http://<ім'я-сервісу>:8080.
WEB_UPSTREAM=http://host.docker.internal:5173
KEYCLOAK_UPSTREAM=http://keycloak:8080
TENANT_UPSTREAM=http://host.docker.internal:3001
SCHOOL_UPSTREAM=http://host.docker.internal:3002
TIMETABLE_UPSTREAM=http://host.docker.internal:3003
